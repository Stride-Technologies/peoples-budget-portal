# Skip commitlint for merge commits and squash merge messages — these are
# generated by git/GitHub Desktop and don't follow Conventional Commits format.
commit_msg=$(cat "$1")
if echo "$commit_msg" | grep -qE "^Merge |^Revert |^fixup\! |^squash\! "; then
  exit 0
fi

pnpm dlx commitlint --edit "$1"
