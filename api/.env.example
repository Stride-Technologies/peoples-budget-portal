# Copy this file to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────────────────
# The default matches docker-compose.dev.yml.
DATABASE_URL="postgresql://portal:portal@localhost:5432/budget_portal?schema=public"

# ── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate a key pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste each file's content as a single-line string with \n for newlines,
# or use a multi-line env loader.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email verification / 2FA ─────────────────────────────────────────────────
# How many days a verification is valid before the user must re-verify (2FA)
EMAIL_VERIFICATION_DAYS=30
# Laptop only: every emailed sign-in code is 000000. Refused when NODE_ENV is
# staging or production; never set it on a deployment anyone else can reach.
# AUTH_FIXED_OTP=1

# ── Mail ─────────────────────────────────────────────────────────────────────
# Providers: console, azure-communication, smtp.
# Defaults: staging/production -> azure-communication; everything else -> console.
MAIL_PROVIDER="console"

# Required for MAIL_PROVIDER=azure-communication. These are non-secret values
# when deployed by Terraform; the API authenticates with managed identity.
ACS_EMAIL_ENDPOINT="https://<resource-name>.communication.azure.com"

# ACS connection string auth; use instead of AZURE_CLIENT_ID on non-Azure servers (e.g. DO VPS).
# ACS_CONNECTION_STRING="endpoint=https://...;accesskey=..."
# Prepend to all outgoing email subjects. Set to "[TEST]" on staging; leave unset on production.
# MAIL_SUBJECT_PREFIX="[TEST]"
AZURE_CLIENT_ID="<user-assigned-managed-identity-client-id>"
MAIL_FROM_ADDRESS="DoNotReply@example.azurecomm.net"
MAIL_FROM_NAME="Budget Portal"

# Optional SMTP fallback, only required when MAIL_PROVIDER=smtp.
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="noreply@example.com"
MAIL_PASS="change-me"
MAIL_FROM="Budget Portal <noreply@example.com>"

# ── URLs ──────────────────────────────────────────────────────────────────────
# Frontend base URL — used in invite and password-reset email links
FRONTEND_URL="http://localhost:3000"
# API base URL — used as the JWKS issuer
API_URL="http://localhost:8000"

# ── Seed ──────────────────────────────────────────────────────────────────────
# The first administrator, created by `prisma db seed` and `db:seed:city`. Change both before seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"

# ── App ──────────────────────────────────────────────────────────────────────
PORT=8000
API_VERSION=v1

# ── AIP export ────────────────────────────────────────────────────────────────
# File name of the .xlsx form template the cluster export builds on. Resolved
# under api/templates/ (the committed default ships with the image). Override
# only when the official template is re-issued for a new fiscal year.
# AIP_TEMPLATE_FILE="AIP Cluster Template.xlsx"

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Connection string for response caching and cross-replica SSE pub/sub.
# When unset, the API uses an in-memory cache and in-process SSE dispatch —
# correct for a single replica. Set this to run Redis-backed caching and
# multi-replica SSE fan-out.
#
# Local dev, if you want to exercise the real Redis paths (the registry caches
# behave the same either way, so a bug in them shows up identically without it):
#   docker run -d --name budget-portal-redis --restart unless-stopped -p 6379:6379 redis:7-alpine
#
# Heads-up: a Homebrew `redis-server` and the sibling stride/asenza containers all
# bind host 6379, so only one can run at a time — `brew services stop redis` or
# stop the other container first. `delByPrefix` SCANs the keyspace, so give the portal
# its own instance rather than sharing one.
# REDIS_URL="redis://localhost:6379"

# ── Whose portal this is ─────────────────────────────────────────────────────
# The API (budget exports) and the client (every page) read the same variables.
# The first three are enough; the rest override a derived name or add a detail.
LGU_SHORT_NAME="Sample"            # "San Isidro"
LGU_TYPE="city"                    # city | municipality | province
LGU_PROVINCE=""                    # province, or region for an independent city
# LGU_PLACE_NAME=""                # default: "<short name> City" for a city, else the short name
# LGU_OFFICIAL_NAME=""             # default: "City of <short name>"
# LGU_GOVERNMENT=""                # default: "City Government of <short name>"
# SITE_NAME=""                     # default: "<place name> Budget Portal"
# STAFF_APP_NAME=""                # default: "<short name> Open Budget Portal"
# LGU_SEAL_SRC="/seal.png"         # a file under client/public; unset draws a monogram
# SITE_PALETTE=""                  # civic-blue | harbor-teal | forest | maroon | slate | amber-ink
# LGU_WEBSITE=""                   # the LGU's own site, linked from the footer
# LGU_ADDRESS=""                   # footer address; separate lines with |
# LGU_BUDGET_ARCHIVE_URL=""        # where older budgets are posted, with the first year below
# LGU_BUDGET_ARCHIVE_FROM=""
# LGU_CONTACT_EMAIL=""             # where questions about the portal and personal data go (privacy policy, terms)
# LGU_CONTACT_PHONE=""
# LEGAL_TEXT_EFFECTIVE=""          # e.g. "June 18, 2026". Unset: the privacy policy and terms say they are a template
# The next three are read when the client is BUILT (NEXT_PUBLIC_*), not when it starts.
# NEXT_PUBLIC_GOAL_NAME=""         # what the LGU calls a top-level goal; default "Development Priority"
# NEXT_PUBLIC_GOALS_NAME=""        # its plural; default "Development Priorities"
# NEXT_PUBLIC_SOURCE_PDF_PREFIX="" # e.g. https://www.example.gov.ph/wp-content/uploads/ : scanned PDFs staff may open in the source viewer

# ── Data Explorer (specs/018) ─────────────────────────────────────────────────
# Off by default. AI stays off in production until DPO/CITO clearance (SECURITY.md).
# EXPLORER_ENABLED="1"
# EXPLORER_AI_ENABLED="1"
# EXPLORER_LOG_QUESTIONS="0"          # 1 = store question text (personal data, 12-month retention)
# EXPLORER_DAILY_BUDGET_USD="5"
# EXPLORER_DEVICE_SALT=""             # any long random string
# EXPLORER_PROMPT_VERSION="2"
# EMBED_MODEL="text-embedding-3-small"   # words → catalogue values by meaning; unset = aliases only
# EXPLORER_INCLUDE_DRAFTS="0"             # dev only: draft LEPs/ordinances and draft topics
# LLM_BASE_URL="https://<your-resource>.openai.azure.com/openai/v1"
# LLM_MODEL=""
# LLM_AUTH="entra"                    # or "key" with LLM_API_KEY
# LLM_API_KEY=""
# LLM_PRICE_IN_PER_MTOK="3"
# LLM_PRICE_OUT_PER_MTOK="15"
# Inference backends (specs/020 B3, docs/modules/inference-sidecar.md): openai (default) | sidecar | stride,
# for all capabilities or one (_COMPLETE, _EMBED, _DECIDE). A bad combination fails at boot.
# EXPLORER_INFERENCE="openai"
# EXPLORER_INFERENCE_EMBED=""
# EXPLORER_INFERENCE_DECIDE=""
# SIDECAR_URL="http://inference:8100"
# SIDECAR_API_KEY=""
# STRIDE_API_URL=""                   # the Stride inference API; needs EXPLORER_STRIDE_OPT_IN=1 (the LGU's opt-in)
# STRIDE_API_KEY=""
# EXPLORER_STRIDE_OPT_IN=""
# EXPLORER_TRAINING_CAPTURE=""          # specs/020 B4: keep opted-in, scrubbed questions; OFF until the privacy notice says so
# EXPLORER_PRIVACY_NOTICE_VERSION=""    # the notice in force; capture stays off while empty
# EXPLORER_TRAINING_SCRUB_REMOTE=""     # allow the person check on the Stride API (decide=stride); off: questions never reach Stride for scrubbing

# ── Agent tooling (MCP) ───────────────────────────────────────────────────────
# Supabase personal access token for the MCP server configured in .mcp.json.
# Generate at https://supabase.com/dashboard/account/tokens
# Set in your shell profile, NOT in this file — it is personal and not committed.
# export SUPABASE_ACCESS_TOKEN="sbp_..."
