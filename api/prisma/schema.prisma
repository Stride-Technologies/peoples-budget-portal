generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STAFF
  HEAD
  SUPER_ADMIN
}

enum IdentityType {
  LGU // Local Government Unit
  NCPC // Naga City People's Council
  LFC // Local Finance Committee
  DEVELOPER // Developer — no office or org; access is its role, permissions and office scope
}

enum OfficeType {
  MANDATORY // DBM BOM Annex D type "1"
  OPTIONAL // DBM BOM Annex D type "2"
  OTHERS // DBM BOM Annex D type "3"
}

/// Which sheet an office prints on in the complete-AIP workbook.
///
/// Editorial, not derived: the budget office's four-way split cuts across both
/// `PAPSector` (only three are in use) and `Cluster` (eight), so neither can
/// produce it. See `Office.aipSectorGroup`.
enum AipSectorGroup {
  GENERAL_PUBLIC
  ECONOMIC
  ENVI_INFRA
  SOCIAL
}

/// Administrative actions recorded against a user account (control panel → Users).
enum UserAuditAction {
  ROLE_CHANGED
  OFFICE_CHANGED
  ACTIVATED
  DEACTIVATED
  PROFILE_UPDATED // first/last name edits
  LOGIN // successful authentication
  LOGIN_FAILED // failed authentication against an existing account
  PASSWORD_CHANGED // self-service change while logged in
  PASSWORD_RESET_REQUESTED // forgot-password link requested
  PASSWORD_RESET // password set via reset link
  PERMISSIONS_CHANGED // permission grants added or removed (Phase 1 D11)
  OFFICE_SCOPE_CHANGED // office scope grants or the all-offices flag changed (D2)
}

enum ExpenseClass {
  PS // Personnel Services
  MOOE // Maintenance and Other Operating Expenses
  FE // Financial Expenses (2023 Budget Operations Manual's fourth class)
  CO // Capital Outlay
}

/// The LBP Form 7 column an office's money prints in (FY2026 ordinance's
/// sector summary). Independent of `officeType`, which is an AIP code segment.
enum Form7Column {
  GENERAL_PUBLIC
  SOCIAL
  ECONOMIC
  ECONOMIC_ENTERPRISE
}

/// Closed set (spec: PPMP Creation). No admin CRUD — unlike UACSObject/FinishLine,
/// this taxonomy is fixed for the feature, not a reference table.
enum PPMPProjectType {
  GOODS
  SERVICES
  CONSULTING_SERVICES
  INFRASTRUCTURE_PROJECTS
}

/// Closed set (spec: PPMP Creation). Deliberately simplified relative to the
/// full GPPB alternative-methods taxonomy — see specs/001-ppmp-creation/spec.md
/// Assumptions.
enum PPMPProcurementMode {
  SMALL_VALUE_PROCUREMENT
  COMPETITIVE_BIDDING
  NEGOTIATED_PROCUREMENT
  HIGHLY_TECHNICAL_CONSULTANTS
}

/// A Project's own categorization, picked at creation — modeled on
/// `PapClass` (same first three labels) but a separate enum, not a reuse:
/// Digitalization has no AIP-code-segment equivalent, and this never feeds
/// the AIP code format the way PapClass does.
enum PpmpClassification {
  GENERAL_ADMINISTRATIVE_SERVICES
  SUPPORT_TO_OPERATIONS
  OPERATIONS
  DIGITALIZATION
}

/// specs/012 D9: Indicative before the budget is enacted, Final after.
enum PpmpKind {
  INDICATIVE
  FINAL
}

/// A simple two-state approval gate, deliberately not a Program-style
/// multi-stage workflow (no SUBMITTED/HEAD_REVIEWED/PENDING_APPROVAL, no
/// committee sequencing). DRAFT is the only state a new Project starts in;
/// APPROVED is required before Publish is allowed. Any content edit while
/// APPROVED reverts the Project to DRAFT so it must be re-approved before it
/// can be (re)published — see PpmpService.revertToDraftIfApproved.
enum PpmpStatus {
  DRAFT
  APPROVED
  /// Reached only from APPROVED, only if the Project was already published —
  /// editing it then unpublishes it (see PpmpService.draftRevertPatch) and
  /// marks it REVISION rather than plain DRAFT, so the registry can tell
  /// "never published" apart from "was live, now under review" and offer
  /// "Republish" instead of "Publish" once it's re-approved.
  REVISION
}

enum ClimatePillar {
  ADAPTATION
  MITIGATION
  CROSSCUTTING
}

/// LOCKED is the pre-012 name for ADOPTED. Both are read as "adopted"; new
/// transitions write ADOPTED, and LOCKED is removed by the specs/012 contract
/// migration (P8) once no row and no running build uses it.
enum AIPCycleStatus {
  PLANNING
  OPEN
  CLOSED
  LOCKED
  ADOPTED
}

enum ProgramStatus {
  DRAFT
  FOR_REVISION // retained: legacy + Phase 2
  SUBMITTED // retained: legacy + Phase 2
  HEAD_REVIEWED // retained: legacy + Phase 2
  PENDING_APPROVAL // retained: legacy + Phase 2
  APPROVED // retained: legacy + Phase 2
  REJECTED // retained: legacy only
  PUBLISHED // NEW (Phase 1) — published, no pending edits
  PUBLISHED_REVISION // NEW (Phase 1) — published, with an unpublished draft on top
  ARCHIVED // specs/013 — was PUBLISHED; superseded, read-only, in no total
}

/// The AIP form's three appropriation sections, in the order they are printed.
/// Nullable on Program: pre-existing rows have no value and export under
/// OPERATIONS, which is where they already appeared.
enum PapClass {
  GAS // I. General Administration and Support
  STO // II. Support to Operations
  OPERATIONS // III. Operations
}

/// Where a PPA's money comes from. Multi-valued and amount-less by design: the
/// budget office lists the funds a PPA draws on, it does not split the estimate
/// across them — so this is an enum array, not a join table with amounts.
enum FundSource {
  GF // General Fund
  SEF // Special Education Fund
  LDF // Local Development Fund
  LDRRMF // Local Disaster Risk Reduction and Management Fund
  SPA // Special Purpose Appropriation
  PPP // Public-Private Partnership
  NGA // National Government Agency
  DONATIONS_GRANTS
  GAD // Gender and Development
  TRUST_FUND
  SHF // Special Health Fund (Universal Health Care Act)
  EDF // Economic Development Fund
  CCN // City College of Naga
  JOINT_VENTURE
  BORROWINGS
}

enum PPAType {
  PROJECT
  ACTIVITY
}

enum PPACostMode {
  DIRECT_COSTS
  ACTIVITY_CHILDREN
}

enum VerdictType {
  APPROVE
}

/// Who recorded an advisory endorsement (NCPC endorser pivot Phase 2).
/// LGU  → a canEndorse city office's HEAD  (endorserOfficeId set, endorserCsoId null)
/// NCPC → the NCPC umbrella head           (endorserOfficeId null, endorserCsoId null)
///        or a CSO representative          (endorserOfficeId null, endorserCsoId set)
enum EndorserType {
  LGU
  NCPC
}

/// An LFC member office's decision on a ProgramVersion.
/// RETURNED = recoverable bounce (program → FOR_REVISION); the proponent revises.
/// REJECTED = terminal rejection (program → REJECTED); no final code is ever issued.
enum ApprovalStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum CommentStage {
  SECTOR_FEEDBACK
  HEAD_REVIEW
  ENDORSEMENT
  APPROVAL
  GENERAL
  PUBLIC_FEEDBACK
}

enum CommentTarget {
  PROGRAM
  PROJECT_ACTIVITY
  LINE_ITEM
}

enum RegistryFeedbackCategory {
  GENERAL
  SPECIFIC_PPA
  BUDGET_TRANSPARENCY
  FINISH_LINE_PROGRESS
  OTHER
  PROGRAM_SUGGESTION
}

enum ProgramFeedbackCategory {
  GENERAL
  CONCERN
  SUGGESTION
  QUESTION
  OTHER
}

enum ProgramCommentSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

/// Actions recorded against a program in the append-only edit history.
/// Distinct from ProgramVersion, which snapshots published *content*.
enum ProgramAuditAction {
  PROGRAM_CREATED
  PROGRAM_UPDATED // field-level edit; `changes` carries before/after
  PA_ADDED
  PA_UPDATED
  PA_REMOVED
  ESTIMATE_UPDATED // PS/MOOE/CO change, called out separately from PA_UPDATED
  REVISION_OPENED
  DRAFT_SAVED
  DRAFT_DISCARDED
  PUBLISHED
  REPUBLISHED
  COMMENT_POSTED
  COMMENT_REPLIED
  COMMENT_RESOLVED
  COMMENT_UNRESOLVED
  COMMENT_DELETED
  COMMENT_RESTORED
  PUBLIC_REPLY_POSTED
  PUBLIC_FEEDBACK_REVIEWED
  EXPORTED
  IMPORT_REVIEWED // the office confirmed the 2027 import's decisions on a program
  TAG_ADDED // thematic tag applied directly to a Program or PA
  TAG_REMOVED // thematic tag removed directly from a Program or PA
  ARCHIVED // specs/013; `changes` carries { reason }
  UNARCHIVED
}

enum AuditTargetType {
  PROGRAM
  PROJECT_ACTIVITY
  COMMENT
  LINE_ITEM // reserved — Phase 2
}

enum ExportType {
  CLUSTER
  /// One office's "Mandate, Vision/Mission, Major Final Output, Performance
  /// Indicators and Targets" sheet, as the city prints it.
  AB_OFFICE
  /// Every office's sheet in one document — the Annual Budget book.
  AB_BOOK
  /// The whole city's AIP in one workbook: a sheet per `AipSectorGroup`, then a
  /// funding-source breakdown.
  COMPLETE_AIP
  LBP4_OFFICE // LBP Form 4, one office (xlsx)
  LBP4_BOOK // LBP Form 4, every office in scope (xlsx)
  LBP7 // LBP Form 7, city-wide (xlsx)
}

enum ExportStatus {
  PENDING
  GENERATED
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A Naga city office — the single office catalog. `officeCode` and
/// `officeType` were a separate `DBMOffice` table until the AIP coding system
/// was reissued as one flat list; there is no longer a DBM/city distinction.
///
/// `officeCode` is free text (`"01"`, and `"11 (1)"` for the second office
/// sharing base code 11) and deliberately **not unique**: several offices
/// legitimately share a code, and the parenthetical suffix is the city's own
/// disambiguator. Two offices on the same code+type emit identical AIP
/// reference codes — the control panel warns, it does not block.
model Office {
  id        String   @id @default(uuid(7))
  name      String
  acronym   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  canEndorse Boolean @default(false) @map("can_endorse")

  /// AIP code segment 3. Always 2 (City) here — every office is a Naga city
  /// office — but stored rather than hardcoded so the segment has one source.
  lguLevel Int @default(2) @map("lgu_level")

  /// AIP code segments 3 and 4. Nullable: offices predating the reissued
  /// coding system may not be coded yet, and AIPCodesService rejects those at
  /// program-create time rather than emitting a malformed code.
  ///
  /// `officeCode` is stored the way the city's coding sheet writes it, spaces
  /// and all ("11 (1)"). The code segment strips the whitespace on emit — the
  /// sheet prints the office column with the space and the code without it.
  officeType OfficeType? @map("office_type")
  officeCode String?     @map("office_code")

  /// The office's header block on the printed AB sheet ("Mandate,
  /// Vision/Mission, Major Final Output, Performance Indicators and Targets").
  /// All optional — the city leaves Vision and Mission blank on several sheets,
  /// and an office with no profile still has programs.
  mandateLegalBasis String? @map("mandate_legal_basis")
  vision            String?
  mission           String?

  /// One row per outcome on the printed sheet. The blank template shows 1..n
  /// rows; AB 2026 crams them into a single cell, so the importer splits and
  /// the import report lists every split for review.
  organizationalOutcomes String[] @map("organizational_outcomes")

  cluster   Cluster @relation(fields: [clusterId], references: [id])
  clusterId String  @map("cluster_id")

  /// specs/018: the office whose line this office continues in year-over-year
  /// charts. Null = itself. A renamed or merged office points at the surviving
  /// row, so the explorer plots one line across years. Seeded from
  /// prisma/data/office-lineage.json (CPDO's map); never derived from names.
  lineageId String? @map("lineage_id")

  /// The office's usual PAP sector, used to pre-select the sector field on the
  /// new-program form.
  ///
  /// Advisory only — **not** an AIP code segment. The code's sector segment
  /// comes from `Program.papSectorId`, so editing this never restates a code
  /// (unlike `officeCode` / `officeType`, which do).
  papSector   PAPSector? @relation(fields: [papSectorId], references: [id])
  papSectorId String?    @map("pap_sector_id")

  /// Which sheet this office prints on in the complete-AIP workbook.
  ///
  /// Nullable and normally left null: `resolveSectorGroup` derives the group
  /// from `papSector` (1000/9000 → GENERAL_PUBLIC, 3000/4000/5000 → SOCIAL,
  /// 6000/8000 → ECONOMIC), so a newly added office is never dropped from the
  /// workbook. Set it only for the offices the budget office files somewhere
  /// else than their sector implies — nine of them, seeded from offices.json.
  aipSectorGroup AipSectorGroup? @map("aip_sector_group")

  /// LBP Form 7 column. Null = unassigned: Form 7 leaves the office out of the
  /// columns and lists it on its notes sheet. A special fund has none — its
  /// money prints as a lump sum instead.
  form7Column   Form7Column? @map("form7_column")
  /// Deprecated (specs/016): special funds are funds, not offices. Read by
  /// nothing; dropped in phase 6.
  isSpecialFund Boolean      @default(false) @map("is_special_fund")

  lguusers                 LGUUser[]
  programs                 Program[]                 @relation("ImplementingOffice")
  /// Programs proposed by another office that print inside this office's AB
  /// sheet, under its COMPONENT PROGRAMS band. See `Program.hostOfficeId`.
  hostedComponentPrograms  Program[]                 @relation("ComponentHost")
  endorsements             ProgramEndorsement[]
  committeeMemberships     CommitteeMembership[]
  programApprovals         ProgramApproval[]
  programSupportingOffices ProgramSupportingOffice[]
  approvalBatches          ProgramApprovalBatch[]
  userOfficeScopes         UserOfficeScope[]
  programAuditLogs         ProgramAuditLog[]
  ppmps                    PPMP[]
  specialFundAmounts       SpecialFundAmount[]

  budgetItems        BudgetItem[]         @relation("BudgetItemOffice")
  hostedBudgetItems  BudgetItem[]         @relation("BudgetItemHostOffice")
  budgetHeaders      BudgetOfficeHeader[]
  budgetObjectLines  BudgetObjectLine[]
  budgetReceiptLines BudgetReceiptLine[]

  @@index([lineageId])
  @@map("offices")
}

model User {
  id              String        @id @default(uuid(7))
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  email           String        @unique
  password        String?
  role            Role          @default(STAFF)
  identityType    IdentityType? @map("identity_type")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  isActive        Boolean       @default(true) @map("is_active")
  lastVerifiedAt  DateTime?     @map("last_verified_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  /// Fast path for office scoping (Phase 1 D2). When true, the user may act on
  /// every city office's AIP records and `UserOfficeScope` is not consulted.
  /// Carried in the JWT; the office id list is not (§5.4).
  allOfficesScope Boolean @default(false) @map("all_offices_scope")

  emailVerifications                 EmailVerification[]
  refreshTokens                      RefreshToken[]
  userInvites                        UserInvite[]
  passwordResetTokens                PasswordResetToken[]
  lguusers                           LGUUser[]
  ncpcusers                          NCPCUser[]
  registryFeedbackReviews            PublicRegistryFeedback[]     @relation("FeedbackReviewer")
  auditLogsAsTarget                  UserAuditLog[]               @relation("AuditTarget")
  auditLogsAsActor                   UserAuditLog[]               @relation("AuditActor")
  permissions                        UserPermission[]
  permissionsGranted                 UserPermission[]             @relation("UserPermissionGrantedBy")
  programAuditLogs                   ProgramAuditLog[]            @relation("ProgramAuditActor")
  officeScopes                       UserOfficeScope[]
  officeScopesGranted                UserOfficeScope[]            @relation("UserOfficeScopeGrantedBy")
  invitesSent                        UserInvite[]                 @relation("UserInviteSentBy")
  ppmpComments                       PpmpComment[]
  createdThematicTags                ThematicTag[]
  appliedProgramThematicTags         ProgramThematicTag[]
  appliedProjectActivityThematicTags ProjectActivityThematicTag[]

  budgetDocumentsFinalized BudgetDocument[]         @relation("BudgetDocumentFinalizedBy")
  budgetDocumentAudits     BudgetDocumentAuditLog[]
  budgetItemTagsApplied    BudgetItemThematicTag[]

  @@map("users")
}

/// Mirror of `PERMISSION_CATALOG` (api/src/permissions/permission-catalog.ts),
/// reconciled at every application bootstrap by `PermissionCatalogSyncService`.
/// The code is the source of truth; this table exists so the control-panel UI can
/// query keys and so `UserPermission` has something to reference.
///
/// Rows whose key leaves the catalog are flagged `isActive = false` rather than
/// deleted — `UserPermission` may still reference them historically.
model Permission {
  key         String  @id
  label       String
  module      String
  description String
  /// False for keys reserved for a later phase: grantable, but nothing gates on
  /// them yet. Mirrors `PermissionDefinition.enforced`.
  enforced    Boolean @default(false)
  isActive    Boolean @default(true) @map("is_active")

  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

/// Explicit grant of one permission key to one user. **Grant-only**: absence is
/// denial, and `Role` contributes nothing at runtime (Phase 1 D11). The §6
/// templates are presets that write these rows; every row stays independently
/// editable afterwards.
model UserPermission {
  userId    String   @map("user_id")
  key       String   @map("key")
  grantedBy String   @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [key], references: [key], onDelete: Cascade)
  granter    User       @relation("UserPermissionGrantedBy", fields: [grantedBy], references: [id])

  @@id([userId, key])
  @@index([key])
  @@index([grantedBy])
  @@map("user_permissions")
}

/// Explicit grant: this user may act on this city office's AIP records.
/// Independent of `LGUUser`, which records the user's *home* office — the two are
/// unioned by `OfficeScopeService.effectiveOfficeIds` so existing users keep
/// today's access with no backfill.
///
/// Stored per office, never per cluster (Phase 1 D2): the control panel groups the
/// picker by cluster for convenience, but a cluster reorganisation must not
/// silently change anyone's access.
model UserOfficeScope {
  userId    String   @map("user_id")
  officeId  String   @map("office_id")
  grantedBy String   @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  office  Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  granter User   @relation("UserOfficeScopeGrantedBy", fields: [grantedBy], references: [id])

  @@id([userId, officeId])
  @@index([officeId])
  @@index([grantedBy])
  @@map("user_office_scopes")
}

model LGUUser {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  officeId  String   @map("office_id")
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([officeId])
  @@map("lgu_users")
}

model NCPCUser {
  id                         String                    @id @default(uuid(7))
  userId                     String                    @map("user_id")
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: null = the NCPC umbrella head (endorses "as NCPC as a whole").
  // A set CSO = that CSO's representative (NCPC endorser pivot Phase 2).
  civilSocietyOrganizationId String?                   @map("civil_society_organization_id")
  civilSocietyOrganization   CivilSocietyOrganization? @relation(fields: [civilSocietyOrganizationId], references: [id], onDelete: Cascade)
  createdAt                  DateTime                  @default(now()) @map("created_at")

  @@index([userId])
  @@map("ncpc_users")
}

/// Immutable audit trail of administrative changes to a user account: role
/// reassignment, office reassignment, and (de)activation. One row per changed
/// field per edit. `summary` carries a human-readable before→after string and
/// `metadata` the structured before/after values for richer rendering.
model UserAuditLog {
  id           String          @id @default(uuid(7))
  targetUserId String          @map("target_user_id")
  targetUser   User            @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUserId  String          @map("actor_user_id")
  actor        User            @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  actorRole    Role            @map("actor_role")
  action       UserAuditAction
  summary      String
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([targetUserId])
  @@index([actorUserId])
  @@map("user_audit_logs")
}

/// One record per verification attempt. Expired/used records are kept for audit.
model EmailVerification {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // bcrypt hash of the 6-digit code
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verifications")
}

/// Stored as a SHA-256 hash of the raw token. Raw token is sent to client once and never stored.
model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique // SHA-256 hash of the raw token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// One-time token emailed to a new user so they can set their password.
/// All invite data is stored here; the User row is only created when the invite is accepted.
/// userId is null until accepted; revokedAt allows admins to cancel an outstanding invite.
model UserInvite {
  id     String  @id @default(uuid(7))
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName                  String        @map("first_name")
  lastName                   String        @map("last_name")
  email                      String
  role                       Role          @default(STAFF)
  identityType               IdentityType? @map("identity_type")
  officeId                   String?       @map("office_id")
  civilSocietyOrganizationId String?       @map("civil_society_organization_id")

  /// The grants to apply when the invite is accepted (Phase 1 D11/D2). Held here
  /// rather than on the user because the User row does not exist until then, and
  /// the admin decides access at invite time, not later.
  ///
  /// Plain arrays rather than join tables: an invite is short-lived and its
  /// payload is never queried by key, so `user_permissions` / `user_office_scopes`
  /// remain the only things anything reads for authorization.
  permissions     String[] @default([])
  allOfficesScope Boolean  @default(false) @map("all_offices_scope")
  officeScopeIds  String[] @default([]) @map("office_scope_ids")

  /// Who sent the invite, and therefore who chose the grants above. Becomes the
  /// `granted_by` on the resulting UserPermission / UserOfficeScope rows, so the
  /// audit column names a real decision-maker rather than the invitee.
  invitedByUserId String? @map("invited_by_user_id")
  invitedBy       User?   @relation("UserInviteSentBy", fields: [invitedByUserId], references: [id])

  token     String    @unique // SHA-256 hash of the raw token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@map("user_invites")
}

/// One-time token emailed to a user to reset their password.
model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique // SHA-256 hash of the raw token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model FinishLine {
  id                 String                    @id @default(uuid(7))
  name               String
  fullName           String                    @map("full_name")
  visionNumber       Int?                      @map("vision_number")
  shortName          String?                   @map("short_name")
  color              String?
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  subFinishLines     SubFinishLine[]
  finishLineClusters FinishLineCluster[]
  budgetCeilings     FinishLineBudgetCeiling[]
  programs           Program[]

  budgetItems BudgetItem[]

  @@map("finish_lines")
}

model SubFinishLine {
  id           String     @id @default(uuid(7))
  code         String     @unique
  name         String
  finishLineId String     @map("finish_line_id")
  finishLine   FinishLine @relation(fields: [finishLineId], references: [id])
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  programs     Program[]

  @@index([finishLineId])
  @@map("sub_finish_lines")
}

model Cluster {
