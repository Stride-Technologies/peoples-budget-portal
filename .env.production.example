# ═══════════════════════════════════════════════════════════════════════════════
# People's Budget Portal — production settings (docker-compose.yml)
# Copy to .env beside docker-compose.yml on the server and fill in every value.
# Never commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── The site's address ────────────────────────────────────────────────────────
# The one place it is set: nginx, the TLS certificate, the API and the client's
# links all read it. No scheme, no slash.
SITE_HOST="budget.example.gov.ph"

# ── Whose portal this is ─────────────────────────────────────────────────────
# The API (budget exports) and the client (every page) read the same variables.
# The first three are enough; the rest override a derived name or add a detail.
LGU_SHORT_NAME="Sample"            # "San Isidro"
LGU_TYPE="city"                    # city | municipality | province
LGU_PROVINCE=""                    # province, or region for an independent city
# LGU_PLACE_NAME=""                # default: "<short name> City" for a city, else the short name
# LGU_OFFICIAL_NAME=""             # default: "City of <short name>"
# LGU_GOVERNMENT=""                # default: "City Government of <short name>"
# SITE_NAME=""                     # default: "<place name> Budget Portal"
# STAFF_APP_NAME=""                # default: "<short name> Open Budget Portal"
# LGU_SEAL_SRC="/seal.png"         # a file under client/public; unset draws a monogram
# SITE_PALETTE=""                  # civic-blue | harbor-teal | forest | maroon | slate | amber-ink
# LGU_WEBSITE=""                   # the LGU's own site, linked from the footer
# LGU_ADDRESS=""                   # footer address; separate lines with |
# LGU_BUDGET_ARCHIVE_URL=""        # where older budgets are posted, with the first year below
# LGU_BUDGET_ARCHIVE_FROM=""
# LGU_CONTACT_EMAIL=""             # where questions about the portal and personal data go (privacy policy, terms)
# LGU_CONTACT_PHONE=""
# LEGAL_TEXT_EFFECTIVE=""          # e.g. "June 18, 2026". Unset: the privacy policy and terms say they are a template
# The next three are read when the client is BUILT (NEXT_PUBLIC_*), not when it starts.
# NEXT_PUBLIC_GOAL_NAME=""         # what the LGU calls a top-level goal; default "Development Priority"
# NEXT_PUBLIC_GOALS_NAME=""        # its plural; default "Development Priorities"
# NEXT_PUBLIC_SOURCE_URL=""       # your fork's address, if you run a changed copy (the AGPL asks you to offer its source); default: the upstream project
# NEXT_PUBLIC_SOURCE_PDF_PREFIX="" # e.g. https://www.example.gov.ph/wp-content/uploads/ : scanned PDFs staff may open in the source viewer

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — local Postgres container (default; run with --profile local-db)
# The password comes first: DATABASE_URL below reads it.
POSTGRES_PASSWORD="<strong random password>"
DATABASE_URL="postgresql://portal:${POSTGRES_PASSWORD}@postgres:5432/portal"
# Option B — a managed Postgres (comment out A above, uncomment B, then:
#   docker compose --profile local-db down)
# DATABASE_URL="postgresql://USER:PASS@HOST:25060/portal?sslmode=require"

# ── JWT (RS256 key pair) ───────────────────────────────────────────────────────
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste each as a single line using literal \n for newlines.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email (ACS via connection string — managed identity unavailable on DO) ─────
# Azure Portal → your ACS resource → Keys → Connection string
MAIL_PROVIDER="azure-communication"
ACS_CONNECTION_STRING="endpoint=https://<resource>.communication.azure.com/;accesskey=<key>"
MAIL_FROM_ADDRESS="DoNotReply@<resource>.azurecomm.net"
MAIL_FROM_NAME="Budget Portal"
# MAIL_SUBJECT_PREFIX — leave UNSET on production (staging sets this to "[TEST]")

# ── SMTP fallback (change MAIL_PROVIDER=smtp to switch away from ACS) ─────────
# MAIL_HOST="smtp.example.com"
# MAIL_PORT=587
# MAIL_USER="noreply@example.com"
# MAIL_PASS="<smtp password>"
# MAIL_FROM="Budget Portal <noreply@example.com>"

# ── Client analytics (build-time only) ─────────────────────────────────────────
# NEXT_PUBLIC_* vars are read at BUILD time, not container runtime — source this
# file before `docker build` so values are baked into the bundle via --build-arg.

# Prod Google Analytics measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Discoverability environment (D2, D3). Must be exactly 'production' on DO prod;
# any other value (or unset) locks down robots.txt and adds noindex headers.
NEXT_PUBLIC_SITE_ENV="production"

# Basic Auth gate — intentionally UNSET on prod (D5, D6).
# Set PREVIEW_BASIC_AUTH_USER and PREVIEW_BASIC_AUTH_PASS only on Azure
# staging/preview slots (via Azure App Service application settings).
# PREVIEW_BASIC_AUTH_USER=
# PREVIEW_BASIC_AUTH_PASS=

# reCAPTCHA v3 — real keys from console.cloud.google.com/recaptcha (D13, D24, D25).
# The client site key is baked into the bundle at build time (NEXT_PUBLIC_*).
# NEVER use the Google test keys (6LeIxAcT...) here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="<real reCAPTCHA v3 site key>"
RECAPTCHA_SECRET_KEY="<real reCAPTCHA v3 secret key>"
RECAPTCHA_MIN_SCORE=0.5
# Enforce hostname validation — reject tokens solved on a different domain.
RECAPTCHA_EXPECTED_HOSTNAME="${SITE_HOST}"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=8000
API_VERSION=v1
EMAIL_VERIFICATION_DAYS=3
FRONTEND_URL="https://${SITE_HOST}"
# Used for Let's Encrypt expiry notices
CERTBOT_EMAIL="<your email address>"
# API_URL and REDIS_URL are set per-service in docker-compose.yml — do not set here

# ── DO Spaces (S3-compatible storage: PPMP documents, database backups) ───────
# Any S3-compatible bucket works. No bucket yet? Uncomment the next line: uploads then stay
# inside the API container and are LOST when it is rebuilt. A trial only.
# STORAGE_PROVIDER="local"
# From the access credentials you were given. DO_SPACES_BUCKET is the Space's
# name — the first label of its origin URL. The endpoint may be the Space's
# origin (below) or the regional one (https://sgp1.digitaloceanspaces.com).
DO_SPACES_ENDPOINT="https://<space-name>.sgp1.digitaloceanspaces.com"
DO_SPACES_BUCKET="<space-name>"
DO_SPACES_REGION="sgp1"
DO_SPACES_KEY="<Access Key ID from your credentials>"
DO_SPACES_SECRET="<Secret Key from your credentials>"

# ── Seed (one-time only — remove after first successful seed run) ──────────────
SEED_ADMIN_EMAIL="admin@example.gov.ph"
SEED_ADMIN_PASSWORD="<strong password — change after first login>"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"
